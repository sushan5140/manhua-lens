# Choose ONE LLM provider. Do not put real keys in GitHub or browser settings.
# For live freeform conversation and generated story consequences:
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Alternative: OpenRouter (only checked when GROQ_API_KEY is blank)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Alternative: local Ollama (only checked when both keys are blank).
# Requires Ollama running locally with the named model available.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

PORT=8080
