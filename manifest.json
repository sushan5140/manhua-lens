{
  "manifest_version": 3,
  "name": "Manhua Lens",
  "version": "0.3.0",
  "description": "Select text on any page for word-by-word definitions, readings, translation, and pronunciation across 11 languages.",
  "permissions": ["storage", "activeTab", "scripting", "tts"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_popup": "options.html",
    "default_title": "Manhua Lens settings"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
